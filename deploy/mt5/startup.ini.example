; MT5 start configuration. install.sh copies this to
;   /home/mt5/.mt5/drive_c/Program Files/MetaTrader 5/config/startup.ini  (chmod 600)
; Fill in Login/Password/Server. No comments on the same line as a value.

[Common]
Login=12345678
Password=CHANGE-ME
Server=FTMO-Demo
KeepPrivate=1
NewsEnable=0
CertInstall=0

[Experts]
; EAs only run with AllowLiveTrading on. BarPusher contains no order code.
; The WebRequest allow-list cannot be set here: MT5 stores it encrypted and only takes it from
; Tools > Options > Expert Advisors (see docs/mt5-linux.md, "One-time GUI settings").
AllowLiveTrading=1
AllowDllImport=0
Enabled=1
Account=0
Profile=0

[StartUp]
Expert=BarPusher
ExpertParameters=BarPusher.set
Symbol=GER40.cash
Period=M5
