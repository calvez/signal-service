; MT5 start configuration. install.sh copies this to
;   /home/mt5/.mt5/drive_c/Program Files/MetaTrader 5/config/startup.ini  (chmod 600)
; Fill in Login/Password/Server. No comments on the same line as a value.

[Common]
Login=12345678
Password=CHANGE-ME
Server=FTMO-Demo
KeepPrivate=1
NewsEnable=0
CertInstall=0

[Experts]
; Algorithmic trading OFF (the toolbar "Algo Trading" button is off, and EAs may not trade).
; BarPusher has no order code and keeps running like this: it only writes files. Tested with
; MT5 build 6235: heartbeats keep coming and report trade_allowed=false. MT5 applies this
; section on every start, so a click in the GUI does not survive a restart either. The service
; alerts in Telegram if a heartbeat ever reports algo trading as on.
AllowLiveTrading=0
AllowDllImport=0
Enabled=0
Account=0
Profile=0

[StartUp]
Expert=BarPusher
ExpertParameters=BarPusher.set
Symbol=GER40.cash
Period=M5
